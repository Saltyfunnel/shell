{
  "$schema": "https://zed.dev/schema/themes.json",
  "name": "Material Dynamic",
  "author": "Saltyfunnel",
  "themes": [
    {
      "name": "Material Dynamic",
      "appearance": "dark",
      "style": {
        "background": "{{colors.surface.default.hex}}",
        "surface.background": "{{colors.surface_container_low.default.hex}}",
        "elevated_surface.background": "{{colors.surface_container.default.hex}}",
        "border": "{{colors.outline_variant.default.hex}}",
        "border.variant": "{{colors.outline_variant.default.hex}}",
        "border.focused": "{{colors.primary.default.hex}}",
        "border.selected": "{{colors.primary.default.hex}}",
        "border.disabled": "{{colors.outline_variant.default.hex}}",
        "border.transparent": "#00000000",

        "text": "{{colors.on_surface.default.hex}}",
        "text.muted": "{{colors.on_surface_variant.default.hex}}",
        "text.placeholder": "{{colors.outline.default.hex}}",
        "text.disabled": "{{colors.outline.default.hex}}",
        "text.accent": "{{colors.primary.default.hex}}",
        "link_text.hover": "{{colors.primary.default.hex}}",
        "icon": "{{colors.on_surface_variant.default.hex}}",
        "icon.accent": "{{colors.primary.default.hex}}",
        "icon.muted": "{{colors.outline.default.hex}}",
        "icon.disabled": "{{colors.outline.default.hex}}",

        "element.background": "{{colors.surface_container.default.hex}}",
        "element.hover": "{{colors.surface_container_high.default.hex}}",
        "element.active": "{{colors.surface_container_highest.default.hex}}",
        "element.selected": "{{colors.surface_container_high.default.hex}}",
        "element.disabled": "{{colors.surface_variant.default.hex}}",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "{{colors.surface_container_high.default.hex}}",
        "ghost_element.active": "{{colors.surface_container_highest.default.hex}}",
        "ghost_element.selected": "{{colors.surface_container_high.default.hex}}",
        "ghost_element.disabled": "#00000000",

        "status_bar.background": "{{colors.surface_container_low.default.hex}}",
        "title_bar.background": "{{colors.surface.default.hex}}",
        "toolbar.background": "{{colors.surface.default.hex}}",
        "tab_bar.background": "{{colors.surface_container_low.default.hex}}",
        "tab.active.background": "{{colors.surface.default.hex}}",
        "tab.inactive.background": "{{colors.surface_container_low.default.hex}}",
        "panel.background": "{{colors.surface_container_low.default.hex}}",
        "pane.focused_border": "{{colors.primary.default.hex}}",
        "pane_group.border": "{{colors.outline_variant.default.hex}}",

        "scrollbar.thumb.background": "{{colors.on_surface_variant.default.hex}}40",
        "scrollbar.thumb.hover_background": "{{colors.on_surface_variant.default.hex}}66",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "{{colors.outline_variant.default.hex}}33",

        "editor.foreground": "{{colors.on_surface.default.hex}}",
        "editor.background": "{{colors.surface.default.hex}}",
        "editor.gutter.background": "{{colors.surface.default.hex}}",
        "editor.subheader.background": "{{colors.surface_container_low.default.hex}}",
        "editor.active_line.background": "{{colors.surface_container.default.hex}}",
        "editor.highlighted_line.background": "{{colors.surface_container_high.default.hex}}",
        "editor.line_number": "{{colors.outline.default.hex}}",
        "editor.active_line_number": "{{colors.on_surface.default.hex}}",
        "editor.invisible": "{{colors.outline_variant.default.hex}}",
        "editor.wrap_guide": "{{colors.outline_variant.default.hex}}66",
        "editor.active_wrap_guide": "{{colors.outline_variant.default.hex}}",
        "editor.indent_guide": "{{colors.outline_variant.default.hex}}99",
        "editor.indent_guide_active": "{{colors.outline.default.hex}}",
        "editor.document_highlight.read_background": "{{colors.primary.default.hex}}26",
        "editor.document_highlight.write_background": "{{colors.primary.default.hex}}40",
        "search.match_background": "{{colors.tertiary.default.hex}}4d",

        "terminal.background": "{{colors.surface.default.hex}}",
        "terminal.foreground": "{{colors.on_surface.default.hex}}",
        "terminal.bright_foreground": "{{colors.on_surface.default.hex}}",
        "terminal.ansi.black": "{{colors.surface_container_highest.default.hex}}",
        "terminal.ansi.red": "{{colors.error.default.hex}}",
        "terminal.ansi.green": "{{colors.green.default.hex}}",
        "terminal.ansi.yellow": "{{colors.yellow.default.hex}}",
        "terminal.ansi.blue": "{{colors.blue.default.hex}}",
        "terminal.ansi.magenta": "{{colors.tertiary.default.hex}}",
        "terminal.ansi.cyan": "{{colors.cyan.default.hex}}",
        "terminal.ansi.white": "{{colors.on_surface_variant.default.hex}}",
        "terminal.ansi.bright_black": "{{colors.outline.default.hex}}",
        "terminal.ansi.bright_red": "{{colors.error.default.hex}}",
        "terminal.ansi.bright_green": "{{colors.green.default.hex}}",
        "terminal.ansi.bright_yellow": "{{colors.yellow.default.hex}}",
        "terminal.ansi.bright_blue": "{{colors.blue.default.hex}}",
        "terminal.ansi.bright_magenta": "{{colors.tertiary.default.hex}}",
        "terminal.ansi.bright_cyan": "{{colors.cyan.default.hex}}",
        "terminal.ansi.bright_white": "{{colors.on_surface.default.hex}}",

        "error": "{{colors.error.default.hex}}",
        "error.background": "{{colors.error.default.hex}}26",
        "warning": "{{colors.yellow.default.hex}}",
        "warning.background": "{{colors.yellow.default.hex}}26",
        "info": "{{colors.blue.default.hex}}",
        "info.background": "{{colors.blue.default.hex}}26",
        "hint": "{{colors.cyan.default.hex}}",
        "hint.background": "{{colors.cyan.default.hex}}26",
        "success": "{{colors.green.default.hex}}",
        "success.background": "{{colors.green.default.hex}}26",
        "created": "{{colors.green.default.hex}}",
        "created.background": "{{colors.green.default.hex}}26",
        "modified": "{{colors.yellow.default.hex}}",
        "modified.background": "{{colors.yellow.default.hex}}26",
        "deleted": "{{colors.error.default.hex}}",
        "deleted.background": "{{colors.error.default.hex}}26",
        "conflict": "{{colors.orange.default.hex}}",
        "conflict.background": "{{colors.orange.default.hex}}26",
        "renamed": "{{colors.blue.default.hex}}",
        "renamed.background": "{{colors.blue.default.hex}}26",
        "ignored": "{{colors.outline.default.hex}}",
        "predictive": "{{colors.outline.default.hex}}",

        "accents": [
          "{{colors.primary.default.hex}}",
          "{{colors.tertiary.default.hex}}",
          "{{colors.blue.default.hex}}",
          "{{colors.green.default.hex}}",
          "{{colors.yellow.default.hex}}",
          "{{colors.orange.default.hex}}"
        ],
        "players": [
          {
            "cursor": "{{colors.primary.default.hex}}",
            "background": "{{colors.primary.default.hex}}",
            "selection": "{{colors.primary.default.hex}}40"
          },
          {
            "cursor": "{{colors.tertiary.default.hex}}",
            "background": "{{colors.tertiary.default.hex}}",
            "selection": "{{colors.tertiary.default.hex}}40"
          },
          {
            "cursor": "{{colors.blue.default.hex}}",
            "background": "{{colors.blue.default.hex}}",
            "selection": "{{colors.blue.default.hex}}40"
          }
        ],

        "syntax": {
          "attribute": { "color": "{{colors.tertiary.default.hex}}" },
          "boolean": { "color": "{{colors.orange.default.hex}}" },
          "comment": { "color": "{{colors.outline.default.hex}}", "font_style": "italic" },
          "comment.doc": { "color": "{{colors.on_surface_variant.default.hex}}", "font_style": "italic" },
          "constant": { "color": "{{colors.orange.default.hex}}" },
          "constructor": { "color": "{{colors.yellow.default.hex}}" },
          "embedded": { "color": "{{colors.on_surface.default.hex}}" },
          "emphasis": { "color": "{{colors.tertiary.default.hex}}" },
          "emphasis.strong": { "color": "{{colors.tertiary.default.hex}}", "font_weight": 700 },
          "enum": { "color": "{{colors.yellow.default.hex}}" },
          "function": { "color": "{{colors.blue.default.hex}}" },
          "hint": { "color": "{{colors.outline.default.hex}}" },
          "keyword": { "color": "{{colors.primary.default.hex}}", "font_weight": 700 },
          "label": { "color": "{{colors.tertiary.default.hex}}" },
          "link_text": { "color": "{{colors.primary.default.hex}}" },
          "link_uri": { "color": "{{colors.blue.default.hex}}" },
          "number": { "color": "{{colors.orange.default.hex}}" },
          "operator": { "color": "{{colors.on_surface_variant.default.hex}}" },
          "predictive": { "color": "{{colors.outline.default.hex}}", "font_style": "italic" },
          "preproc": { "color": "{{colors.tertiary.default.hex}}" },
          "primary": { "color": "{{colors.on_surface.default.hex}}" },
          "property": { "color": "{{colors.cyan.default.hex}}" },
          "punctuation": { "color": "{{colors.on_surface_variant.default.hex}}" },
          "punctuation.bracket": { "color": "{{colors.on_surface_variant.default.hex}}" },
          "punctuation.delimiter": { "color": "{{colors.on_surface_variant.default.hex}}" },
          "punctuation.list_marker": { "color": "{{colors.primary.default.hex}}" },
          "punctuation.special": { "color": "{{colors.tertiary.default.hex}}" },
          "string": { "color": "{{colors.green.default.hex}}" },
          "string.escape": { "color": "{{colors.cyan.default.hex}}" },
          "string.regex": { "color": "{{colors.orange.default.hex}}" },
          "string.special": { "color": "{{colors.cyan.default.hex}}" },
          "string.special.symbol": { "color": "{{colors.cyan.default.hex}}" },
          "tag": { "color": "{{colors.primary.default.hex}}" },
          "text.literal": { "color": "{{colors.green.default.hex}}" },
          "title": { "color": "{{colors.primary.default.hex}}", "font_weight": 700 },
          "type": { "color": "{{colors.yellow.default.hex}}" },
          "variable": { "color": "{{colors.on_surface.default.hex}}" },
          "variable.special": { "color": "{{colors.tertiary.default.hex}}" },
          "variant": { "color": "{{colors.yellow.default.hex}}" }
        }
      }
    }
  ]
}
