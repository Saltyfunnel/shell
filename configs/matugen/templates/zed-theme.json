{
  "$schema": "https://zed.dev/schema/themes.json",
  "name": "Material Dynamic",
  "author": "Saltyfunnel",
  "themes": [
    {
      "name": "Material Dynamic",
      "appearance": "dark",
      "style": {
        "background": "{{colors.surface.default.hex}}",
        "text": "{{colors.on_surface.default.hex}}",
        "border": "{{colors.outline_variant.default.hex}}",
        "element.background": "{{colors.surface_container.default.hex}}",
        "element.hover": "{{colors.surface_container_high.default.hex}}",
        "element.active": "{{colors.surface_container_highest.default.hex}}",
        "text.muted": "{{colors.on_surface_variant.default.hex}}",
        "text.accent": "{{colors.primary.default.hex}}",
        "icon": "{{colors.on_surface_variant.default.hex}}",
        "icon.accent": "{{colors.primary.default.hex}}",
        "status_bar.background": "{{colors.surface_container_low.default.hex}}",
        "title_bar.background": "{{colors.surface.default.hex}}",
        "toolbar.background": "{{colors.surface.default.hex}}",
        "tab_bar.background": "{{colors.surface_container_low.default.hex}}",
        "tab.active.background": "{{colors.surface.default.hex}}",
        "tab.inactive.background": "{{colors.surface_container_low.default.hex}}",
        "terminal.background": "{{colors.surface.default.hex}}",
        "terminal.foreground": "{{colors.on_surface.default.hex}}",
        "terminal.ansi.black": "{{colors.surface_container_highest.default.hex}}",
        "terminal.ansi.red": "{{colors.error.default.hex}}",
        "terminal.ansi.green": "{{colors.tertiary.default.hex}}",
        "terminal.ansi.yellow": "{{colors.secondary.default.hex}}",
        "terminal.ansi.blue": "{{colors.primary.default.hex}}",
        "terminal.ansi.magenta": "{{colors.tertiary_container.default.hex}}",
        "terminal.ansi.cyan": "{{colors.primary_container.default.hex}}",
        "terminal.ansi.white": "{{colors.on_surface.default.hex}}"
      }
    }
  ]
}
